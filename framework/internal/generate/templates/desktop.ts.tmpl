// Code generated by desktop. DO NOT EDIT.
//
// Live SQLite queries, the menu, links that open in your browser, and, for an
// app with browser: true, the browser's tabs.
//
// useQuery is a ref holding a query's rows, kept current: it reruns when a
// value in the query changes, as computed does, and the backend sends the
// changed rows whenever the data under it changes, from whatever wrote it.
// onMenu runs a function when an item of the menu in desktop.yaml is chosen.
import { Browser, Call, Events } from "@wailsio/runtime";
import { getCurrentScope, onScopeDispose, shallowRef, unref, watch, type ShallowRef } from "vue";

/** A SELECT and its values, made with the sql tag. */
export interface Query {
  readonly text: string;
  readonly args: readonly unknown[];
}

/**
 * Makes a query. Each ${value} is sent as a parameter, never pasted into the
 * SQL, so a value cannot change what the query does. Write it bare, not in
 * quotes: sql`... WHERE name = ${name}`.
 */
export function sql(strings: TemplateStringsArray, ...values: unknown[]): Query {
  return { text: strings.join("?"), args: values.map((v) => unref(v)) };
}

/**
 * The rows of a query, kept current. The array is replaced on every change;
 * rows that did not change keep the same objects, so Vue does not redraw
 * them. It starts empty, and is empty while query returns null.
 *
 *   const notes = useQuery<Note>(() => sql`SELECT * FROM notes WHERE folder = ${folder.value}`);
 *
 * The query runs on a read-only connection: it can read anything, and change
 * nothing. Save data through a Go method.
 */
export function useQuery<T = Record<string, unknown>>(
  query: () => Query | null | undefined | false,
): Readonly<ShallowRef<readonly T[]>> {
  listen();
  const rows = shallowRef<readonly T[]>(Object.freeze([]));
  let current: Live | null = null;
  let currentKey = "";

  const stop = watch(
    query,
    (q) => {
      // The getter returns a new object each time it runs, so compare what
      // it says, not which object it is.
      const key = q ? JSON.stringify([q.text, q.args]) : "";
      if (key === currentKey) {
        return;
      }
      currentKey = key;
      end(current);
      current = null;
      if (!q) {
        rows.value = Object.freeze([]);
        return;
      }
      const l: Live = {
        id: String(++lastID),
        query: q,
        version: 0,
        rows: [],
        waiting: [],
        attempt: 0,
        set(next) {
          l.rows = next;
          rows.value = Object.freeze(next) as readonly T[];
        },
      };
      live.set(l.id, l);
      current = l;
      void subscribe(l);
    },
    { immediate: true },
  );

  if (getCurrentScope()) {
    onScopeDispose(() => {
      stop();
      end(current);
    });
  }
  return rows;
}

/** The events the menu in desktop.yaml sends. */
export type MenuEvent = {{with .Config.Menu.Events}}{{range $i, $e := .}}{{if $i}} | {{end}}{{json $e}}{{end}}{{else}}never{{end}};

/**
 * Calls handler when a menu item from desktop.yaml is chosen, by the event
 * it names:
 *
 *   onMenu("new-note", () => notes.create());
 *
 * In a component or a store, it stops when that does. It returns a function
 * that stops it sooner.
 */
export function onMenu(event: MenuEvent, handler: () => void): () => void {
  const off = Events.On(menuEvent, (e: { data?: unknown }) => {
    if (e.data === event) {
      handler();
    }
  });
  if (getCurrentScope()) {
    onScopeDispose(off);
  }
  return off;
}

const menuEvent = "desktop:menu";

/** Whether your browser can open url: a web page, or an email to write. */
const outside = (url: string) => /^(https?|mailto):/i.test(url);

/**
 * Opens every link in your browser, from here on, never in the app's window:
 * a link in the app leads out of it. Call it once, in main.ts. A link with
 * download saves its file instead, and window.open opens your browser too.
 * Anything that acts in the app is a button, not a link.
 */
export function openLinksInBrowser() {
  // Before anything on the page sees the click, so nothing can let a link
  // load in the window.
  const follow = (e: MouseEvent) => {
    const a = e.target instanceof Element ? e.target.closest("a[href]") : null;
    if (!(a instanceof HTMLAnchorElement) || a.hasAttribute("download")) {
      return;
    }
    e.preventDefault();
    // As written: a.href resolves a path against the window's own address,
    // which in development is http://localhost.
    const href = a.getAttribute("href")!;
    if (outside(href)) {
      void Browser.OpenURL(href);
    }
  };
  document.addEventListener("click", follow, true);
  // The middle button, which would open the link in a new window.
  document.addEventListener("auxclick", (e) => e.button === 1 && follow(e), true);
  window.open = (url) => {
    if (url !== undefined && outside(String(url))) {
      void Browser.OpenURL(String(url));
    }
    return null;
  };
}

// Everything below talks to desktop's Live service in Go.

const service = "github.com/michaelckearney/monorepo/framework/generated.Live";
const event = "desktop:live";
// The backend drops the queries of a client it has not heard from in a
// minute: a window that closed or reloaded.
const keepEvery = 15_000;

interface Update {
  client: string;
  id: string;
  version: number;
  start: number;
  delete: number;
  rows: unknown[] | null;
  error?: string;
}

interface Snapshot {
  version: number;
  rows: unknown[] | null;
}

interface Live {
  id: string;
  query: Query;
  // The version of rows: 0 until the first result arrives.
  version: number;
  rows: readonly unknown[];
  // Updates can arrive before the first result does; they wait for it.
  waiting: Update[];
  // Which call to Subscribe is the latest, so an older answer is ignored.
  attempt: number;
  set(rows: unknown[]): void;
}

// One per page load. Every window gets every update, and keeps its own.
const client =
  globalThis.crypto?.randomUUID?.() ?? `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
const live = new Map<string, Live>();
let lastID = 0;
let listening = false;

function listen(): void {
  if (listening) {
    return;
  }
  listening = true;
  Events.On(event, (e: { data?: unknown }) => {
    const u = e.data as Update | undefined;
    if (!u || u.client !== client) {
      return;
    }
    const l = live.get(u.id);
    if (!l) {
      // A query this page has ended; make sure the backend has too.
      void Call.ByName(`${service}.Unsubscribe`, client, u.id).catch(() => {});
      return;
    }
    if (l.version === 0) {
      l.waiting.push(u);
      return;
    }
    apply(l, u);
  });
  setInterval(() => {
    if (live.size === 0) {
      return;
    }
    Call.ByName(`${service}.Keep`, client)
      .then((kept: boolean) => {
        if (!kept) {
          // The backend dropped this page, such as after the machine slept.
          for (const l of live.values()) {
            void subscribe(l);
          }
        }
      })
      .catch(() => {});
  }, keepEvery);
}

function apply(l: Live, u: Update): void {
  if (u.version <= l.version) {
    return;
  }
  if (u.version !== l.version + 1) {
    // An update went missing, so these rows are not what the backend's
    // splices are relative to. Start again from a fresh result.
    void subscribe(l);
    return;
  }
  l.version = u.version;
  if (u.error) {
    report(l, u.error);
    return;
  }
  const next = l.rows.slice();
  next.splice(u.start, u.delete, ...(u.rows ?? []));
  l.set(next);
}

async function subscribe(l: Live): Promise<void> {
  const attempt = ++l.attempt;
  l.version = 0;
  l.waiting = [];
  let snapshot: Snapshot;
  try {
    snapshot = (await Call.ByName(`${service}.Subscribe`, client, l.id, l.query.text, l.query.args)) as Snapshot;
  } catch (err) {
    if (live.get(l.id) === l) {
      report(l, err);
    }
    return;
  }
  if (live.get(l.id) !== l || attempt !== l.attempt) {
    return;
  }
  l.version = snapshot.version;
  l.set(snapshot.rows ?? []);
  const waiting = l.waiting;
  l.waiting = [];
  for (const u of waiting) {
    apply(l, u);
  }
}

function end(l: Live | null): void {
  if (!l) {
    return;
  }
  live.delete(l.id);
  void Call.ByName(`${service}.Unsubscribe`, client, l.id).catch(() => {});
}

function report(l: Live, err: unknown): void {
  const message = err instanceof Error ? err.message : String(err);
  console.error(`useQuery: ${message}\n  in: ${l.query.text.replace(/\s+/g, " ").trim()}`);
}
{{- if .Config.Browser}}

// The browser, for an app with browser: true: useTab follows a tab of
// package browser's Chromium, and LiveView shows one, live, and sends it
// your mouse and keys. Frames and changes arrive as events, so no call to
// Go stays open while a tab is shown.
import { defineComponent, h, onBeforeUnmount, onMounted, onUpdated, reactive, ref, Comment, type VNode } from "vue";

const tabs = "github.com/michaelckearney/monorepo/framework/browser.Tabs";
const tabEvent = "desktop:browser:tab";
const frameEvent = "desktop:browser:frame";
const cursorEvent = "desktop:browser:cursor";
const pageMenuEvent = "desktop:browser:menu";

/** Where a tab is, as useTab has it. */
export interface TabState {
  readonly id: string;
  readonly url: string;
  readonly title: string;
  readonly loading: boolean;
  readonly canGoBack: boolean;
  readonly canGoForward: boolean;
  /** The IDs of the tabs it opened, directly or through another, oldest first. */
  readonly opened: readonly string[];
  readonly closed: boolean;
}

/** A tab, kept current, and what you can do with it. */
export interface Tab extends TabState {
  navigate(url: string): Promise<void>;
  back(): Promise<void>;
  forward(): Promise<void>;
  reload(): Promise<void>;
  close(): Promise<void>;
}

/**
 * The tab whose ID id returns, kept current: its address, its title, and the
 * tabs it opened. Every field is empty while id returns null.
 *
 *   const tab = useTab(() => props.tab);
 *   tab.url; tab.back();
 *
 * In a component or a store, it stops following the tab when that does.
 */
export function useTab(id: () => string | null | undefined): Readonly<Tab> {
  const empty = (tab: string): TabState => ({
    id: tab, url: "", title: "", loading: false, canGoBack: false, canGoForward: false, opened: [], closed: false,
  });
  async function call(method: string, ...args: unknown[]): Promise<void> {
    if (tab.id) {
      await Call.ByName(`${tabs}.${method}`, tab.id, ...args);
    }
  }
  const tab: { -readonly [K in keyof Tab]: Tab[K] } = reactive({
    ...empty(""),
    navigate: (url: string) => call("Navigate", url),
    back: () => call("Back"),
    forward: () => call("Forward"),
    reload: () => call("Reload"),
    close: () => call("Close"),
  });
  const set = (s: TabState) => Object.assign(tab, s, { opened: Object.freeze([...(s.opened ?? [])]) });
  const off = Events.On(tabEvent, (e: { data?: unknown }) => {
    const s = e.data as TabState | undefined;
    if (s && s.id === tab.id) {
      set(s);
    }
  });
  const stop = watch(
    id,
    async (next, previous) => {
      if (previous) {
        void Call.ByName(`${tabs}.Unwatch`, previous).catch(() => {});
      }
      set(empty(next ?? ""));
      if (!next) {
        return;
      }
      const s = (await Call.ByName(`${tabs}.Watch`, next)) as TabState;
      if (tab.id === next) {
        set(s);
      }
    },
    { immediate: true },
  );
  if (getCurrentScope()) {
    onScopeDispose(() => {
      stop();
      off();
      if (tab.id) {
        void Call.ByName(`${tabs}.Unwatch`, tab.id).catch(() => {});
      }
    });
  }
  return tab;
}

/**
 * Shows a tab, live, and sends it your mouse, keys, and pastes, as a browser
 * window would: it takes your keys when it shows, has the cursor the page
 * would give the mouse, copies to your clipboard, and opens the browser's
 * menu on a right-click. The page is laid out at the size LiveView has, so
 * give it one: a height, as well as the width it takes. Its default slot is
 * drawn over the page, and takes the mouse while it shows: the place for the
 * app's own prompts.
 *
 *   <LiveView :tab="id" style="height: 70vh" @problem="(m) => (problem = m)" />
 */
export const LiveView = defineComponent({
  name: "LiveView",
  props: { tab: { type: String, required: true } },
  emits: { problem: (message: string) => typeof message === "string" },
  setup(props, { slots, emit }) {
    const box = ref<HTMLElement | null>(null);
    // Frames are drawn on a canvas, not shown as an image: WebKit offers to
    // select an image, and macOS's Live Text reads the text in it, so a
    // right-click on an image of the page selected all its text.
    const canvas = ref<HTMLCanvasElement | null>(null);
    // Keys go to a hidden text box, not the image: a key no text box takes,
    // such as Option-Delete, goes on to macOS, which acts on it. In a text
    // box it is an edit, which the page's handlers stop.
    const keys = ref<HTMLTextAreaElement | null>(null);
    // The cursor the page gives the mouse where it is.
    const cursor = ref("default");
    // The page's size in CSS pixels, which input coordinates are in.
    let width = 1;
    let height = 1;
    let shown = "";
    const report = (e: unknown) => emit("problem", e instanceof Error ? e.message : String(e));

    function show() {
      const el = box.value;
      if (!el || !el.clientWidth || !el.clientHeight) {
        return;
      }
      shown = props.tab;
      Call.ByName(`${tabs}.Show`, props.tab, el.clientWidth, el.clientHeight, globalThis.devicePixelRatio || 1).catch(report);
    }
    function hide() {
      if (shown) {
        void Call.ByName(`${tabs}.Hide`, shown).catch(() => {});
        shown = "";
      }
    }
    // A new size lays the page out again, once the resizing stops.
    let resizing: ReturnType<typeof setTimeout> | undefined;
    const resized = new ResizeObserver(() => {
      clearTimeout(resizing);
      resizing = setTimeout(show, 150);
    });
    // Frames decode out of order, so only the newest is drawn; drawn counts
    // them, and a new tab starts the count again.
    let latest = 0;
    async function draw(f: { jpeg: string; width: number; height: number }) {
      const n = ++latest;
      const bytes = Uint8Array.from(atob(f.jpeg), (c) => c.charCodeAt(0));
      const image = await createImageBitmap(new Blob([bytes], { type: "image/jpeg" }));
      const c = canvas.value;
      if (n !== latest || !c) {
        image.close();
        return;
      }
      if (c.width !== image.width || c.height !== image.height) {
        c.width = image.width;
        c.height = image.height;
      }
      c.getContext("2d")!.drawImage(image, 0, 0);
      image.close();
      width = f.width;
      height = f.height;
    }
    function blank() {
      latest++;
      const c = canvas.value;
      c?.getContext("2d")?.clearRect(0, 0, c.width, c.height);
    }
    const offFrame = Events.On(frameEvent, (e: { data?: unknown }) => {
      const f = e.data as { tab: string; jpeg: string; width: number; height: number } | undefined;
      if (f && f.tab === props.tab) {
        draw(f).catch(report);
      }
    });
    const offCursor = Events.On(cursorEvent, (e: { data?: unknown }) => {
      const c = e.data as { tab: string; cursor: string } | undefined;
      if (c && c.tab === props.tab) {
        cursor.value = c.cursor;
      }
    });
    // A right-click the page left to the browser opens the browser's menu,
    // where you clicked.
    let rightClick = { x: 0, y: 0 };
    const offMenu = Events.On(pageMenuEvent, (e: { data?: unknown }) => {
      if (e.data === props.tab) {
        Call.ByName(`${tabs}.OpenMenu`, props.tab, Math.round(rightClick.x), Math.round(rightClick.y)).catch(report);
      }
    });

    // The view takes your keys when it shows, as a window you open does,
    // unless you are typing somewhere else in the app, or in its prompt.
    const typingElsewhere = () => {
      const el = document.activeElement;
      if (!el || el === document.body || el === keys.value) {
        return false;
      }
      return (
        box.value!.contains(el) ||
        el instanceof HTMLInputElement ||
        el instanceof HTMLTextAreaElement ||
        el instanceof HTMLSelectElement ||
        (el instanceof HTMLElement && el.isContentEditable)
      );
    };
    const takeKeys = () => {
      if (!typingElsewhere()) {
        keys.value?.focus({ preventScroll: true });
      }
    };
    onMounted(() => {
      resized.observe(box.value!);
      show();
      takeKeys();
    });
    watch(
      () => props.tab,
      (_, previous) => {
        if (document.activeElement === keys.value) {
          void Call.ByName(`${tabs}.Focus`, previous, false).catch(() => {});
        }
        hide();
        blank();
        cursor.value = "default";
        show();
        if (document.activeElement === keys.value) {
          void Call.ByName(`${tabs}.Focus`, props.tab, true).catch(() => {});
        } else {
          takeKeys();
        }
      },
    );
    // When the prompt drawn over the page goes, the view takes your keys
    // back, unless you went elsewhere.
    let prompted = false;
    let prompting = false;
    onUpdated(() => {
      if (prompted && !prompting) {
        takeKeys();
      }
      prompted = prompting;
    });
    // Going away is not your keys going elsewhere: Hide gives the page its
    // focus back, for whatever uses the tab next.
    let unmounting = false;
    onBeforeUnmount(() => {
      unmounting = true;
      resized.disconnect();
      clearTimeout(resizing);
      clearTimeout(trailing);
      offFrame();
      offCursor();
      offMenu();
      hide();
    });

    // Input goes in order: each call waits for the one before it.
    let sending: Promise<unknown> = Promise.resolve();
    function send(ev: Record<string, unknown>) {
      const tab = props.tab;
      sending = sending.then(() => Call.ByName(`${tabs}.Input`, tab, ev)).catch(report);
    }
    const modifiers = (e: MouseEvent | KeyboardEvent) =>
      (e.altKey ? 1 : 0) | (e.ctrlKey ? 2 : 0) | (e.metaKey ? 4 : 0) | (e.shiftKey ? 8 : 0);
    const at = (e: MouseEvent) => ({
      x: (e.offsetX * width) / canvas.value!.clientWidth,
      y: (e.offsetY * height) / canvas.value!.clientHeight,
    });
    const buttons = ["left", "middle", "right"];
    const mouse = (type: string, e: MouseEvent) =>
      send({ kind: "mouse", type, ...at(e), button: buttons[e.button], clickCount: e.detail, modifiers: modifiers(e) });
    // Moves are sent at most every 40 ms, enough for hover menus and
    // dragging, and the last one always goes, so the page knows where the
    // mouse stopped.
    const moveEvery = 40;
    let lastMove = 0;
    let trailing: ReturnType<typeof setTimeout> | undefined;
    const sendMove = (e: MouseEvent) => {
      lastMove = Date.now();
      send({ kind: "mouse", type: "mouseMoved", ...at(e), button: e.buttons & 1 ? "left" : "none", modifiers: modifiers(e) });
    };
    // macOS editing shortcuts are commands to Chromium, not keys it acts on.
    // Each is named by its modifiers, in this order, and its key.
    const macCommands: Record<string, string> = {
      "Meta+a": "selectAll",
      "Meta+c": "copy",
      "Meta+x": "cut",
      "Meta+z": "undo",
      "Meta+Shift+z": "redo",
      "Meta+ArrowLeft": "moveToLeftEndOfLine",
      "Meta+Shift+ArrowLeft": "moveToLeftEndOfLineAndModifySelection",
      "Meta+ArrowRight": "moveToRightEndOfLine",
      "Meta+Shift+ArrowRight": "moveToRightEndOfLineAndModifySelection",
      "Meta+ArrowUp": "moveToBeginningOfDocument",
      "Meta+Shift+ArrowUp": "moveToBeginningOfDocumentAndModifySelection",
      "Meta+ArrowDown": "moveToEndOfDocument",
      "Meta+Shift+ArrowDown": "moveToEndOfDocumentAndModifySelection",
      "Meta+Backspace": "deleteToBeginningOfLine",
      "Alt+ArrowLeft": "moveWordLeft",
      "Alt+Shift+ArrowLeft": "moveWordLeftAndModifySelection",
      "Alt+ArrowRight": "moveWordRight",
      "Alt+Shift+ArrowRight": "moveWordRightAndModifySelection",
      "Alt+ArrowUp": "moveToBeginningOfParagraph",
      "Alt+ArrowDown": "moveToEndOfParagraph",
      "Alt+Backspace": "deleteWordBackward",
      "Alt+Delete": "deleteWordForward",
      "Control+a": "moveToBeginningOfParagraph",
      "Control+e": "moveToEndOfParagraph",
      "Control+k": "deleteToEndOfParagraph",
      "Control+h": "deleteBackward",
      "Control+d": "deleteForward",
    };
    const shortcut = (e: KeyboardEvent) =>
      (e.ctrlKey ? "Control+" : "") + (e.altKey ? "Alt+" : "") + (e.metaKey ? "Meta+" : "") + (e.shiftKey ? "Shift+" : "") +
      (e.key.length === 1 ? e.key.toLowerCase() : e.key);
    const handlers = {
      onMousedown(e: MouseEvent) {
        e.preventDefault();
        keys.value!.focus({ preventScroll: true });
        if (e.button === 2) {
          rightClick = { x: e.clientX, y: e.clientY };
        }
        mouse("mousePressed", e);
      },
      onMouseup: (e: MouseEvent) => mouse("mouseReleased", e),
      onMousemove(e: MouseEvent) {
        clearTimeout(trailing);
        const wait = lastMove + moveEvery - Date.now();
        if (wait > 0) {
          trailing = setTimeout(() => sendMove(e), wait);
          return;
        }
        sendMove(e);
      },
      // The page lets go of what the mouse was over, as it does when the
      // mouse leaves a window.
      onMouseleave() {
        clearTimeout(trailing);
        send({ kind: "mouse", type: "mouseMoved", x: -1, y: -1, button: "none", modifiers: 0 });
      },
      onWheel(e: WheelEvent) {
        e.preventDefault();
        send({ kind: "mouse", type: "mouseWheel", ...at(e), deltaX: e.deltaX, deltaY: e.deltaY, modifiers: modifiers(e) });
      },
      onContextmenu: (e: MouseEvent) => e.preventDefault(),
    };
    // A key an input method takes, such as a dead key for an accent or a
    // key while composing Japanese, is the input method's: what it composes
    // arrives as composition events, and goes to the page as text.
    const composing = (e: KeyboardEvent) => e.isComposing || e.keyCode === 229 || e.key === "Dead";
    const clear = () => {
      keys.value!.value = "";
    };
    const keyHandlers = {
      onKeydown(e: KeyboardEvent) {
        // A paste arrives as its own event, with the text.
        if ((e.metaKey || e.ctrlKey) && e.key === "v") {
          return;
        }
        if (composing(e)) {
          return;
        }
        e.preventDefault();
        const printable = e.key.length === 1 && !e.metaKey && !e.ctrlKey;
        const text = printable ? e.key : e.key === "Enter" ? "\r" : "";
        const command = macCommands[shortcut(e)];
        send({
          kind: "key", type: text ? "keyDown" : "rawKeyDown", key: e.key, code: e.code, text,
          keyCode: e.keyCode, modifiers: modifiers(e), commands: command ? [command] : [],
        });
      },
      onKeyup(e: KeyboardEvent) {
        if (composing(e)) {
          return;
        }
        e.preventDefault();
        send({ kind: "key", type: "keyUp", key: e.key, code: e.code, keyCode: e.keyCode, modifiers: modifiers(e) });
      },
      onPaste(e: ClipboardEvent) {
        e.preventDefault();
        send({ kind: "text", text: e.clipboardData?.getData("text") ?? "" });
      },
      onCompositionupdate(e: CompositionEvent) {
        send({ kind: "composition", text: e.data });
      },
      onCompositionend(e: CompositionEvent) {
        send({ kind: "text", text: e.data });
        clear();
      },
      // Text typed without a key the view sends, such as from the emoji
      // picker. What a composition typed went already.
      onInput(e: Event) {
        const ev = e as InputEvent;
        if (ev.isComposing || ev.inputType === "insertFromComposition" || ev.inputType === "insertCompositionText") {
          return;
        }
        if (ev.data) {
          send({ kind: "text", text: ev.data });
        }
        clear();
      },
      // The page has your focus while the view has your keys, as a window's
      // page does while the window is in front.
      onFocus: () => void Call.ByName(`${tabs}.Focus`, props.tab, true).catch(report),
      onBlur: () => {
        if (!unmounting) {
          void Call.ByName(`${tabs}.Focus`, props.tab, false).catch(() => {});
        }
      },
    };

    return () => {
      const over = (slots.default?.() ?? []).filter((n: VNode) => n.type !== Comment);
      prompting = over.length > 0;
      return h("div", {
        ref: box, class: "desktop-live-view",
        style: { position: "relative", overflow: "hidden" },
      }, [
        h("canvas", {
          ref: canvas, "aria-label": "The page",
          style: { display: "block", width: "100%", height: "100%", cursor: cursor.value, userSelect: "none", WebkitUserSelect: "none" },
          ...handlers,
        }),
        h("textarea", {
          ref: keys, "aria-label": "Keys for the page", autocomplete: "off", spellcheck: false,
          style: { position: "absolute", top: "0", left: "0", width: "1px", height: "1px", opacity: "0", padding: "0", border: "0", resize: "none" },
          ...keyHandlers,
        }),
        over.length ? h("div", { style: { position: "absolute", inset: "0" } }, over) : null,
      ]);
    };
  },
});
{{- end}}
